+// Writer-local scratch storage; immutable reader snapshots never own this buffer.
+#[derive(Default)]
+struct CatalogBuffer {
+    bytes: Vec<u8>,
+}
+impl CatalogBuffer {
+    fn encode<T: Serialize>(&mut self, value: &T) -> Result<&[u8]> {
+        self.bytes.clear();
+        serde_json::to_writer(&mut self.bytes, value).map_err(|e| Error::new(e.to_string()))?;
+        Ok(&self.bytes)
+    }
+    fn release(&mut self) {
+        self.bytes.clear();
+        if self.bytes.capacity() > MAX_RETAINED_CATALOG_BYTES {
+            self.bytes = Vec::new();
+        }
+    }
+}
